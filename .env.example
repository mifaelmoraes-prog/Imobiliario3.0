# Voz neural do Concierge (Gemini TTS e/ou OpenAI TTS). Copie para .env.local e preencha.
# Só o servidor lê estas variáveis: nunca use o prefixo VITE_ nas chaves.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Provedor principal: openai | gemini (sem isso, usa a OpenAI se houver chave).
# Se o principal falhar, o outro é tentado quando tiver chave.
# TTS_PROVIDER=openai
# Opcionais
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Sulafat
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
