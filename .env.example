# API Keys para IA (Servidor e Voz Neural / Client)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Configurações de Voz Neural do Concierge (/api/tts)
# Provedor principal: openai | gemini (se omitido, usa openai se houver chave)
# TTS_PROVIDER=openai
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Sulafat
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin

# Cérebro do Concierge (/api/concierge) usa a mesma OPENAI_API_KEY.
# Evite modelos com limite baixo de requisições por minuto na sua conta:
# cada resposta faz 2 chamadas (buscar e responder).
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_CHAT_REASONING=none
# Se o principal bater o limite, tenta estes (cada modelo tem a própria cota):
# OPENAI_CHAT_FALLBACK_MODELS=gpt-4.1-mini,gpt-5.4,gpt-4.1,gpt-5.4-nano
# (não use gpt-4o-mini: a voz gpt-4o-mini-tts divide a cota dele)

# Supabase (Banco de Dados e Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Alertas do Concierge ("me avisa quando aparecer"): deixe desligado até aplicar a migração
# supabase/migrations/20261113120000_concierge_alertas.sql no Supabase.
# Na fase 1 o alerta só é registrado (o aviso automático vem na fase 2).
# CONCIERGE_ALERTS=on
# Log de uso de tokens e voz no servidor (padrão ligado): CONCIERGE_LOG_USAGE=0 desliga

# Feedback ao final do atendimento ("tem algo que eu possa melhorar?"): deixe desligado até aplicar
# supabase/migrations/20261113130000_concierge_feedback.sql no Supabase.
# CONCIERGE_FEEDBACK=on
