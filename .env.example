# API Keys para IA (Servidor e Voz Neural / Client)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Voz do atendimento (/api/tts): sempre a OpenAI, com uma voz fixa no código (cedar, masculina,
# em server/openaiTts.js). Não há variável para trocar a voz nem reserva no Gemini ou na voz do
# navegador: a voz não pode mudar no meio do atendimento. Sem a chave, responde só por texto.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Cérebro do Concierge (/api/concierge) usa a mesma OPENAI_API_KEY.
# Evite modelos com limite baixo de requisições por minuto na sua conta:
# cada resposta faz 2 chamadas (buscar e responder).
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_CHAT_REASONING=none
# Se o principal bater o limite, tenta estes (cada modelo tem a própria cota):
# OPENAI_CHAT_FALLBACK_MODELS=gpt-4.1-mini,gpt-5.4,gpt-4.1,gpt-5.4-nano
# (não use gpt-4o-mini: a voz gpt-4o-mini-tts divide a cota dele)

# Supabase (Banco de Dados e Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Alertas do Concierge ("me avisa quando aparecer"): deixe desligado até aplicar a migração
# supabase/migrations/20261113120000_concierge_alertas.sql no Supabase.
# Na fase 1 o alerta só é registrado (o aviso automático vem na fase 2).
# CONCIERGE_ALERTS=on
# Log de uso de tokens e voz no servidor (padrão ligado): CONCIERGE_LOG_USAGE=0 desliga

# Feedback ao final do atendimento ("tem algo que eu possa melhorar?"): deixe desligado até aplicar
# supabase/migrations/20261113130000_concierge_feedback.sql no Supabase.
# CONCIERGE_FEEDBACK=on

# Acessos por estado (UF): registra só país, UF e hora (sem IP nem identificador) em
# concierge_acessos. Deixe desligado até aplicar
# supabase/migrations/20261117120000_concierge_acessos.sql no Supabase. Só funciona na Vercel
# (a UF vem do cabeçalho da borda); em desenvolvimento local não grava nada.
# TRACK_ACCESS_REGION=on

# Limite de chamadas por visitante (IP) a cada 10 minutos, nas rotas que gastam dinheiro.
# Padrão: 60 no Concierge e 120 na voz. Vale por instância da função (ver server/guard.js);
# configure também o teto de gasto no painel da OpenAI/Google.
# RATE_LIMIT_CONCIERGE=60
# RATE_LIMIT_TTS=120

# Aviso por e-mail quando um visitante pede contato de corretor (Resend, https://resend.com).
# Sem as duas primeiras variáveis nada é enviado (o contato continua salvo no Supabase).
# LEAD_NOTIFY_EMAIL aceita vários endereços separados por vírgula. Por enquanto vai para o Mifael.
# LEAD_NOTIFY_EMAIL=
# RESEND_API_KEY=
# LEAD_NOTIFY_FROM="Urban Real State <contato@seu-dominio.com.br>"  # padrão: onboarding@resend.dev (só entrega ao dono da conta Resend)
