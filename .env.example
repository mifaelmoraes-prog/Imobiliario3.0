# Voz neural do Concierge (Gemini TTS e/ou OpenAI TTS). Copie para .env.local e preencha.
# Só o servidor lê estas variáveis: nunca use o prefixo VITE_ nas chaves.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Provedor principal: openai | gemini (sem isso, usa a OpenAI se houver chave).
# Se o principal falhar, o outro é tentado quando tiver chave.
# TTS_PROVIDER=openai
# Opcionais
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Sulafat
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# Cérebro do Concierge (/api/concierge) usa a mesma OPENAI_API_KEY.
# Evite modelos com limite baixo de requisições por minuto na sua conta:
# cada resposta faz 2 chamadas (buscar e responder).
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_CHAT_REASONING=none
# Se o principal bater o limite, tenta estes (cada modelo tem a própria cota):
# OPENAI_CHAT_FALLBACK_MODELS=gpt-4.1-mini,gpt-5.4-nano
